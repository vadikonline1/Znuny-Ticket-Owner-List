<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.1">
    <Name>Znuny-Ticket-Owner-List</Name>
    <Version>7.3.1</Version>
    <Vendor>vadikonline1</Vendor>
    <URL>https://github.com/vadikonline1/Znuny-Ticket-Owner-List</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">
        Populate previous and current ticket owner in dynamic field.
    </Description>
    <Framework>7.3.x</Framework>
    <CodeInstall Type="post">
        my $ZnunyHelperObject = $Kernel::OM-&gt;Get('Kernel::System::ZnunyHelper');

        my @DynamicFields = (
            {
                Name       =&gt; 'InvolvedOwner',
                Label      =&gt; &quot;Involved Owner&quot;,
                ObjectType =&gt; 'Ticket',
                FieldType  =&gt; 'Text',
                Config     =&gt; {
                    DefaultValue =&gt; &quot;&quot;,
                },
            },
        );

        $ZnunyHelperObject-&gt;_DynamicFieldsCreateIfNotExists(@DynamicFields);

        my %Screens = (
            'AgentTicketZoom' =&gt; {
                InvolvedOwner =&gt; 1,
            },
        );

        $ZnunyHelperObject-&gt;_DynamicFieldsScreenEnable(%Screens);
    </CodeInstall>
    <CodeUninstall Type="post">
        my $ZnunyHelperObject = $Kernel::OM-&gt;Get('Kernel::System::ZnunyHelper');

        my %Screens = (
            'AgentTicketZoom' =&gt; {
                InvolvedOwner =&gt; 1,
            },
        );

        $ZnunyHelperObject-&gt;_DynamicFieldsScreenDisable(%Screens);
    </CodeUninstall>
    <BuildDate>2026-04-27 14:53:44</BuildDate>
    <BuildHost>znuny.vp.intranet.paypoint.md</BuildHost>
    <Filelist>
        <File Location="Kernel/Config/Files/XML/ZZZTicketOwnerList.xml" Permission="660" Encode="Base64"></File>
        <File Location="Custom/Kernel/System/Ticket/Event/TicketOwnerList.pm" Permission="660" Encode="Base64"></File>
    </Filelist>
</otrs_package>